[Icon Theme]
Name=OneYou
Comment=Material You / Android 16 Monochrome Icon Pack (Craft + YAMIS + Lawnicons)
Inherits=YAMIS,Papirus-Dark,breeze-dark,Adwaita,hicolor
DisplayDepth=32
FollowsColorScheme=true
Example=folder
Directories=apps/scalable,preferences/scalable,places/scalable,places/16,actions/16,actions/scalable,categories/scalable,devices/scalable,emblems/scalable,mimetypes/scalable,status/scalable

