[Icon Theme]
Name=ii-icon-pack
Comment=Material You / Android 16 Monochrome Icon Pack (Craft + YAMIS + Lawnicons + MacTahoe)
Inherits=MacTahoe-dark,MacTahoe,breeze-dark,Adwaita,hicolor
DisplayDepth=32
LinkOverlay=link_overlay
LockOverlay=lock_overlay
ZipOverlay=zip_overlay
DesktopDefault=48
DesktopSizes=16,22,32,48,64,96,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,96,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256
FollowsColorScheme=true
Example=folder
Directories=apps/scalable,apps/symbolic,preferences/scalable,places/scalable,places/symbolic,places/16,places/22,places/24,mimes/scalable,mimes/symbolic,mimes/16,mimes/22,actions/32,actions/symbolic,actions/16,actions/22,actions/24,devices/scalable,devices/32,devices/symbolic,devices/16,devices/22,devices/24,categories/32,categories/symbolic,categories/22,status/32,status/symbolic,status/16,status/22,status/24,emblems/22,emblems/symbolic,emblems/16,emblems/24,emotes/22,emotes/symbolic,animations/16,animations/22,animations/24
ScaledDirectories=apps@2x/scalable,apps@2x/symbolic,preferences@2x/scalable,places@2x/scalable,places@2x/symbolic,places@2x/16,places@2x/22,places@2x/24,mimes@2x/scalable,mimes@2x/symbolic,mimes@2x/16,mimes@2x/22,actions@2x/32,actions@2x/symbolic,actions@2x/16,actions@2x/22,actions@2x/24,devices@2x/scalable,devices@2x/32,devices@2x/symbolic,devices@2x/16,devices@2x/22,devices@2x/24,categories@2x/32,categories@2x/symbolic,categories@2x/22,status@2x/32,status@2x/symbolic,status@2x/16,status@2x/22,status@2x/24,emblems@2x/22,emblems@2x/symbolic,emblems@2x/16,emblems@2x/24,emotes@2x/22,emotes@2x/symbolic,animations@2x/16,animations@2x/22,animations@2x/24

